{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sayova-pair",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",

  // Served on pair.sayova.app, the address compiled into the watch app (sayova.pairBaseUrl in
  // gradle.properties); the website lives apart on sayova.app (site/). The workers.dev address stays
  // reachable for tests.
  "routes": [{ "pattern": "pair.sayova.app", "custom_domain": true }],
  "workers_dev": true,
  // No preview URLs per version: only the deployed page and relay are reachable.
  "preview_urls": false,

  // The page bundle is built before every deploy and dev run.
  "build": { "command": "npm run build:page" },

  // Static page from public/; only the API paths reach the Worker code.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/v1/*"]
  },

  "durable_objects": {
    "bindings": [{ "name": "PAIR", "class_name": "PairSlot" }]
  },

  // Append only, never shorten: Cloudflare remembers the last tag it applied.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PairSlot"] }],

  // No request logs: the pairing ids in the paths are nobody's business, not even ours.
  "observability": { "enabled": false }
}
