{
  "$schema": "../pair/node_modules/wrangler/config-schema.json",
  "name": "sayova-site",
  "compatibility_date": "2026-10-01",

  // SayOVA's website on sayova.app (and www), kept apart from the pairing page on pair.sayova.app (pair/).
  // Static files only, no Worker code.
  "routes": [
    { "pattern": "sayova.app", "custom_domain": true },
    { "pattern": "www.sayova.app", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,

  // The orb script (pair's WebGL orb) is bundled before every deploy, with the esbuild installed for pair/.
  "build": {
    "command": "npx --prefix ../pair esbuild src/main.ts --bundle --minify --format=esm --target=es2022 --outfile=public/orb.js"
  },

  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },

  "observability": { "enabled": false }
}
