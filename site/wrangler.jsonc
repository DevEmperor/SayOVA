{
  "$schema": "../pair/node_modules/wrangler/config-schema.json",
  "name": "sayova-site",
  "compatibility_date": "2026-10-01",

  // SayOVA's website on sayova.app (and www), kept apart from the pairing page on pair.sayova.app (pair/).
  // Static files only, no Worker code.
  "routes": [
    { "pattern": "sayova.app", "custom_domain": true },
    { "pattern": "www.sayova.app", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,

  // Before every deploy build.mjs puts the site together in dist/: the pages in every language, the
  // example conversation's voices and the script (with the esbuild installed for pair/). Needs ffmpeg.
  "build": {
    "command": "node build.mjs"
  },

  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },

  "observability": { "enabled": false }
}
