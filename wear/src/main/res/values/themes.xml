<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Sayova" parent="android:Theme.DeviceDefault">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Theme.Sayova.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <!-- The whole launcher icon at 48 dp, as Google Play's Wear review asks; the foreground layer
             alone failed TunerToGo's review ("Missing app icon in splash screen"). -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_screen</item>
        <item name="postSplashScreenTheme">@style/Theme.Sayova</item>
    </style>
</resources>
